# --- Core ---
DATABASE_URL=postgres://cooldown:cooldown@localhost:5432/cooldown
TEST_DATABASE_URL=postgres://cooldown:cooldown@localhost:5432/cooldown_test
APP_URL=http://localhost:5173
PORT=3001
NODE_ENV=development
# Comma-separated emails allowed to see /admin
ADMIN_EMAILS=

# --- Email (magic links). Leave empty in dev: links are printed to the server console. ---
RESEND_API_KEY=
EMAIL_FROM=Cooldown <login@example.com>

# --- Jev (TypeSafe "System One"). Leave keys empty to use the deterministic fake client. ---
# cloudflare | typesafe | fake
JEV_PROVIDER=fake
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TYPESAFE_API_KEY=

# --- Payments (off by default) ---
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON: [{"id":"pack10","credits":10,"priceId":"price_..."}]
STRIPE_CREDIT_PACKS=
# Credits granted on first sign-in (0 disables)
SIGNUP_FREE_CREDITS=3
